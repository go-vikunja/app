<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers often use a private CA or plain http on the LAN.
     The app asks the user before it continues with an http server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Crash reports go to Sentry over https only, which a CA the user or a
         device policy installed cannot read (decision log: Diagnostics).
         tool/check_exported_components.py checks this. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">sentry.io</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
