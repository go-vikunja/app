<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers often use a private CA or plain http on the LAN.
     The app asks the user before it continues with an http server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
