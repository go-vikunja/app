  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"identifier\" TEXT NOT NULL, \"hex_color\" TEXT NOT NULL, \"parent_project_id\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL CHECK (\"is_archived\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL CHECK (\"is_favorite\" IN (0, 1)), \"position\" REAL NOT NULL, \"owner_id\" INTEGER NULL, \"created\" INTEGER NULL, \"updated\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "project_views",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"project_views\" (\"id\" INTEGER NOT NULL, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"position\" REAL NOT NULL, \"filter_json\" TEXT NULL, \"bucket_configuration_mode\" TEXT NOT NULL, \"default_bucket_id\" INTEGER NOT NULL, \"done_bucket_id\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"labels\" (\"id\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"hex_color\" TEXT NOT NULL, \"created_by_id\" INTEGER NULL, \"created\" INTEGER NULL, \"updated\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER NOT NULL, \"username\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL, \"project_id\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"done\" INTEGER NOT NULL CHECK (\"done\" IN (0, 1)), \"done_at\" INTEGER NULL, \"due_date\" INTEGER NULL, \"start_date\" INTEGER NULL, \"end_date\" INTEGER NULL, \"priority\" INTEGER NOT NULL, \"percent_done\" REAL NOT NULL, \"hex_color\" TEXT NOT NULL, \"identifier\" TEXT NOT NULL, \"index\" INTEGER NOT NULL, \"is_favorite\" INTEGER NOT NULL CHECK (\"is_favorite\" IN (0, 1)), \"position\" REAL NOT NULL, \"repeat_after\" INTEGER NOT NULL, \"repeat_mode\" INTEGER NOT NULL, \"bucket_id\" INTEGER NOT NULL, \"created_by_id\" INTEGER NULL, \"created\" INTEGER NULL, \"updated\" INTEGER NULL, \"sync_run_id\" TEXT NULL, \"pending_changes\" TEXT NULL, \"pending_delete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pending_delete\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_labels\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"label_id\" INTEGER NOT NULL REFERENCES labels (id) ON DELETE CASCADE, PRIMARY KEY (\"task_id\", \"label_id\"));"
        }
      ]
    },
    {
      "name": "task_assignees",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_assignees\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"user_id\" INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE, PRIMARY KEY (\"task_id\", \"user_id\"));"
        }
      ]
    },
    {
      "name": "task_reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_reminders\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"reminder\" INTEGER NULL, \"relative_period\" INTEGER NOT NULL, \"relative_to\" TEXT NULL, PRIMARY KEY (\"task_id\", \"ordinal\"));"
        }
      ]
    },
    {
      "name": "task_relations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_relations\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"other_task_id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, PRIMARY KEY (\"task_id\", \"other_task_id\", \"kind\"));"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" TEXT NOT NULL, \"sequence\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"task_id\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL, \"next_attempt_at\" INTEGER NULL, \"last_attempt_at\" INTEGER NULL, \"state\" TEXT NOT NULL, \"last_error\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
